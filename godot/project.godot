; Engine configuration file.
; It is best edited using the editor, not directly: the editor can write it again in its own order.

config_version=5

[application]

config/name="Agent Workshop"
config/description="Shows AI coding agents at work as penguins in a pixel-art workshop."
run/main_scene="res://src/live.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/version="0.1.0"
config/icon="res://art/images/app_icon.png"
run/flush_stdout_on_print=true

[debug]

gdscript/warnings/treat_warnings_as_errors=true
gdscript/warnings/untyped_declaration=1
gdscript/warnings/integer_division=1

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false
